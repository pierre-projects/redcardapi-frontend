# Backend (redcardapi) base URL, used only for PDF downloads and print config.
# Card content is bundled with the frontend and never needs the API.
# Required for production builds (see vite.config.js).
VITE_API_BASE=http://localhost:8000

# Optional: absolute public URL of this site, used by the prerender step for
# canonical links, hreflang and sitemap.xml (e.g. https://redcards.example.org).
SITE_URL=
